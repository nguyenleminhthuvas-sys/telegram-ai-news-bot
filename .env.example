# Sao chép file này thành ".env" (bỏ ".example") rồi điền giá trị thật vào.
# Khi deploy lên Railway/Render, KHÔNG upload file .env — thay vào đó nhập
# từng biến này vào mục "Environment Variables" trên dashboard của họ.

# --- Bắt buộc ---
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cần ít nhất 1 trong 2 dòng dưới ---
TELEGRAM_PERSONAL_CHAT_ID=123456789
TELEGRAM_CHANNEL_ID=@ten_kenh_cua_ban

# --- Tùy chỉnh (có giá trị mặc định, không bắt buộc điền) ---
CLAUDE_MODEL=claude-sonnet-5
HOT_THRESHOLD=8
FETCH_INTERVAL_MINUTES=30
DIGEST_HOUR=7
TIMEZONE=Asia/Ho_Chi_Minh
DB_PATH=ai_news.db
MAX_ARTICLES_PER_FETCH=40
